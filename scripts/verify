from __future__ import annotations

from http.cookiejar import CookieJar
from urllib.error import HTTPError
import json
import pathlib
import sys
import time
import urllib.request


started = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
old_initialization_id = sys.argv[2]
result_path = pathlib.Path(sys.argv[3])
calls_path = pathlib.Path(sys.argv[4])
assert started["status"] == "started"
base_url = started["base_url"]
cookies = CookieJar()
opener = urllib.request.build_opener(
    urllib.request.ProxyHandler({}), urllib.request.HTTPCookieProcessor(cookies)
)
csrf_token: str | None = None


def request(
    method: str,
    path: str,
    payload: object | None = None,
    *,
    idempotency_key: str | None = None,
) -> object:
    headers = {"Accept": "application/json"}
    data = None
    if payload is not None:
        data = json.dumps(payload, separators=(",", ":")).encode()
        headers.update({"Content-Type": "application/json", "Origin": base_url})
        if csrf_token is not None:
            headers["X-CSRF-Token"] = csrf_token
        if idempotency_key is not None:
            headers["Idempotency-Key"] = idempotency_key
    with opener.open(
        urllib.request.Request(
            f"{base_url}{path}", data=data, headers=headers, method=method
        ),
        timeout=5,
    ) as response:
        return json.load(response)


exchange = request(
    "POST", "/auth/bootstrap", {"token": started["bootstrap_token"]}
)
assert isinstance(exchange, dict)
csrf_token = str(exchange["csrf_token"])

