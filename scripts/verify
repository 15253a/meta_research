import json
import pathlib
import sys
import time
import urllib.request


started = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
success = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
calls_path = pathlib.Path(sys.argv[3])
browser_session_path = pathlib.Path(sys.argv[4])
assert started["status"] == "started"
base_url = started["base_url"]
cookies = CookieJar()
opener = urllib.request.build_opener(
    urllib.request.ProxyHandler({}), urllib.request.HTTPCookieProcessor(cookies)
)
csrf_token = ""


def request(method: str, path: str, payload=None, *, idempotency_key=None):
    headers = {"Accept": "application/json"}
    data = None
    if payload is not None:
        data = json.dumps(payload, separators=(",", ":")).encode()
        headers.update({"Content-Type": "application/json", "Origin": base_url})
        if csrf_token:
            headers["X-CSRF-Token"] = csrf_token
        if idempotency_key:
            headers["Idempotency-Key"] = idempotency_key
    with opener.open(
        urllib.request.Request(
            f"{base_url}{path}", data=data, headers=headers, method=method
        ),
        timeout=5,
    ) as response:
        return json.load(response)


exchange = request(
    "POST", "/auth/bootstrap", {"token": started["bootstrap_token"]}
)
csrf_token = exchange["csrf_token"]
restored = request(
    "GET", f"/api/v1/quest-initializations/{success['initialization_id']}"
)
assert restored["status"] == "completed"
assert restored["quest_ref"] == success["quest_ref"]
assert restored["memory_ref"] == success["memory_ref"]
assert restored["question_ref"] == success["question_ref"]
assert restored["cycle_ref"] == success["cycle_ref"]
assert {
    key: value["receipt_ref"] for key, value in restored["receipts"].items()
} == success["receipt_refs"]
assert all(value["status"] == "accepted" for value in restored["receipts"].values())
assert restored["intent_session"]["turns"] == success["turns"]
assert request("GET", "/api/v1/quest-initializations/current") is None
deadline = time.monotonic() + 10
while True:
    snapshot = request("GET", "/api/v1/snapshot")
    idea_worker = next(
        check
        for check in snapshot["readiness"]["checks"]
        if check["name"] == "idea_stage_worker"
    )
    if idea_worker["status"] == "ready":
        break
    if time.monotonic() >= deadline:
        raise AssertionError(f"providerless Idea worker did not recover: {idea_worker}")
    time.sleep(0.05)
assert snapshot["idea_stage"] == success["idea_stage"]
assert len(calls_path.read_text(encoding="utf-8").splitlines()) == (
    success["provider_call_count"]
)
for key in ("first", "second"):
    expected_experiment = success["experiments"][key]
    attempt_ref = expected_experiment["identities"]["evaluation_attempt_ref"]
    assert request("GET", f"/api/v1/experiments/{attempt_ref}") == (
        expected_experiment
    )
assert snapshot["experiment"] == {
    "status": "active",
    "current": success["experiments"]["second"],
}
second = request(
    "POST",
    "/api/v1/quest-initializations",
    {},
    idempotency_key="installed-second-open",
)
assert second["status"] == "draft"
assert second["quest_draft"]["schema_ref"].endswith("/v2")
assert second["initialization_id"] != success["initialization_id"]
cancelled = request(
    "POST",
    f"/api/v1/quest-initializations/{second['initialization_id']}/cancel",
    {},
    idempotency_key="installed-second-cancel",
)
assert cancelled["status"] == "cancelled"
time.sleep(0.5)
settled = request("GET", "/api/v1/snapshot")
assert next(
    check
    for check in settled["readiness"]["checks"]
    if check["name"] == "idea_stage_worker"
)["status"] == "ready"
assert settled["idea_stage"] == success["idea_stage"]
assert len(calls_path.read_text(encoding="utf-8").splitlines()) == (
    success["provider_call_count"]
)
cookie_values = {cookie.name: cookie.value for cookie in cookies}
assert set(cookie_values) >= {"meta_research_session", "meta_research_csrf"}
current_experiment = success["experiments"]["second"]
current_execution = current_experiment["execution"]
execution_fence_key = (
    f"{current_execution['run_ref']}:g"
    f"{current_execution['attempt_generation']}:"
    f"{current_execution['root_session_ref']}"
)
stage_candidates = [
    (label, settled.get(key))
    for label, key in (
        ("Reasoning", "reasoning_stage"),
        ("Bundle", "bundle_stage"),
        ("Plan", "plan_stage"),
        ("Idea", "idea_stage"),
    )
    if settled.get(key) is not None
]
current_stage = next(
    (
        label
        for label, projection in stage_candidates
        if projection["eligibility"]["status"] in {"eligible", "requested"}
    ),
    stage_candidates[0][0] if stage_candidates else None,
)
assert current_stage is not None
browser_session_path.write_text(
    json.dumps(
        {
            "base_url": base_url,
            "cookies": [
                {
                    "name": "meta_research_session",
                    "value": cookie_values["meta_research_session"],
                    "httpOnly": True,
                },
                {
                    "name": "meta_research_csrf",
                    "value": cookie_values["meta_research_csrf"],
                    "httpOnly": False,
                },
            ],
            "expected": {
                "quest_ref": success["quest_ref"],
                "question_ref": success["question_ref"],
                "stage": current_stage,
                "experiment_title": current_experiment["intent"]["title"],
                "execution_fence_key": execution_fence_key,
            },
        },
        separators=(",", ":"),
    ),
    encoding="utf-8",
)
browser_session_path.chmod(0o600)
PY

test -x /usr/bin/google-chrome
node "$PROJECT_ROOT/web/tests/support/installed-product-browser.mjs" \
  "$BROWSER_SESSION"

"$CLI" stop --data-root "$DATA_ROOT" --json | "$INSTALL_ROOT/bin/python" -c '
import json, sys
assert json.load(sys.stdin)["status"] == "stopped"
'

"$CLI" status --data-root "$DATA_ROOT" --json | "$INSTALL_ROOT/bin/python" -c '
import json, sys
assert json.load(sys.stdin)["status"] == "stopped"
'

"$INSTALL_ROOT/bin/python" - \
  "$START_RESULT" "$RESTART_RESULT" "$FINAL_RESTART_RESULT" "$DATA_ROOT" <<'PY'
import json
import pathlib
import sys

tokens = [
    json.loads(pathlib.Path(path).read_text(encoding="utf-8"))["bootstrap_token"].encode()
    for path in sys.argv[1:-1]
]
for path in pathlib.Path(sys.argv[-1]).rglob("*"):
    if path.is_file():
        contents = path.read_bytes()
        for token in tokens:
            assert token not in contents, f"bootstrap token leaked into {path}"
PY

echo "installed public verification passed"
