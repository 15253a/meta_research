#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$PROJECT_ROOT"
umask 077

VERIFY_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/meta-research-installed-verify.XXXXXX")
INSTALL_ROOT="$VERIFY_ROOT/install"
DATA_ROOT="$VERIFY_ROOT/data"
DIST_ROOT="$VERIFY_ROOT/dist"
PROVIDER_PATH="$VERIFY_ROOT/provider-path"
CODEX_EXECUTABLE="$DATA_ROOT/provider-tools/codex-cli/node_modules/.bin/codex"
CODEX_CALLS="$PROVIDER_PATH/codex-calls.jsonl"
LOCKED_REQUIREMENTS="$VERIFY_ROOT/locked-requirements.txt"
START_RESULT="$VERIFY_ROOT/start.json"
RESTART_RESULT="$VERIFY_ROOT/restart.json"
FINAL_RESTART_RESULT="$VERIFY_ROOT/final-restart.json"
BOOTSTRAP_BODY="$VERIFY_ROOT/bootstrap.json"
AUTH_RESULT="$VERIFY_ROOT/auth.json"
COOKIE_JAR="$VERIFY_ROOT/cookies.txt"
SNAPSHOT="$VERIFY_ROOT/snapshot.json"
SHELL_HTML="$VERIFY_ROOT/shell.html"
SHELL_ASSETS="$VERIFY_ROOT/shell-assets.txt"
SHELL_ASSET_ROOT="$VERIFY_ROOT/shell-assets"
SSE_RESUME="$VERIFY_ROOT/sse-resume.txt"
SSE_GAP="$VERIFY_ROOT/sse-gap.txt"
QUEST_OPENED="$VERIFY_ROOT/quest-opened.json"
QUEST_PROBED="$VERIFY_ROOT/quest-probed.json"
DRAFT_REQUEST="$VERIFY_ROOT/draft-request.json"
QUEST_SAVED="$VERIFY_ROOT/quest-saved.json"
INTENT_REQUEST="$VERIFY_ROOT/intent-request.json"
GENERATION_REQUEST="$VERIFY_ROOT/generation-request.json"
QUEST_VIEW="$VERIFY_ROOT/quest-view.json"
SUCCESS_RESULT="$VERIFY_ROOT/success.json"
BROWSER_SESSION="$VERIFY_ROOT/browser-session.json"

cleanup() {
  if [[ -x "$INSTALL_ROOT/bin/meta-research" ]]; then
    "$INSTALL_ROOT/bin/meta-research" stop \
      --data-root "$DATA_ROOT" --json >/dev/null 2>&1 || true
  fi
  rm -rf -- "$VERIFY_ROOT"
}
trap cleanup EXIT

uv lock --check
uv export --frozen --no-dev --no-emit-project --format requirements.txt \
  --output-file "$LOCKED_REQUIREMENTS" >/dev/null
(
  cd "$PROJECT_ROOT/web"
  npm ci
  npm run build
)
uv build --wheel --out-dir "$DIST_ROOT" >/dev/null
uv venv --python 3.12 "$INSTALL_ROOT" >/dev/null
WHEEL=$(find "$DIST_ROOT" -maxdepth 1 -type f -name '*.whl' -print -quit)
test -n "$WHEEL"
uv pip install --python "$INSTALL_ROOT/bin/python" \
  --requirement "$LOCKED_REQUIREMENTS" >/dev/null
uv pip install --python "$INSTALL_ROOT/bin/python" --no-deps "$WHEEL" >/dev/null
uv pip check --python "$INSTALL_ROOT/bin/python"

CLI="$INSTALL_ROOT/bin/meta-research"
"$CLI" version --json | "$INSTALL_ROOT/bin/python" -c '
import json, sys
assert json.load(sys.stdin) == {"product": "meta-research-vnext", "version": "0.1.0"}
'

mkdir -p "$PROVIDER_PATH"
"$INSTALL_ROOT/bin/python" - "$PROVIDER_PATH/nvidia-smi" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
path.write_text(
    "#!/bin/sh\n"
    "test \"$*\" = \"--query-gpu=uuid,name,memory.total "
    "--format=csv,noheader,nounits\" || exit 64\n"
    "printf '%s\\n' 'GPU-installed-test, Installed Verification GPU, 81920'\n",
    encoding="utf-8",
)
path.chmod(0o755)
PY
"$INSTALL_ROOT/bin/python" - \
  "$PROVIDER_PATH/systemd-inhibit" \
  "$PROVIDER_PATH/systemd-inhibit.registry" <<'PY'
import pathlib
import sys


path = pathlib.Path(sys.argv[1])
registry = pathlib.Path(sys.argv[2])
path.write_text(
    f"""#!{sys.executable}
import os
from pathlib import Path
import subprocess
import sys

registry = Path({str(registry)!r})
arguments = sys.argv[1:]
if "--list" in arguments:
    if registry.exists():
        print(registry.read_text(encoding="utf-8"), end="")
    raise SystemExit(0)
required = {{"--what=sleep", "--mode=block"}}
if not required.issubset(arguments):
    raise SystemExit(41)
command_index = next(
    index for index, argument in enumerate(arguments)
    if not argument.startswith("--")
)
who = next(
    argument.removeprefix("--who=")
    for argument in arguments
    if argument.startswith("--who=")
)
why = next(
    argument.removeprefix("--why=")
    for argument in arguments
    if argument.startswith("--why=")
)
registry.write_text(
    f"{{who}} 1000 installed {{os.getpid()}} python sleep {{why}} block\\n",
    encoding="utf-8",
)
try:
    raise SystemExit(subprocess.call(arguments[command_index:]))
finally:
    registry.unlink(missing_ok=True)
""",
    encoding="utf-8",
)
path.chmod(0o755)
PY
if [[ -e "$CODEX_EXECUTABLE" ]]; then
  echo "providerless verification unexpectedly has a managed Codex CLI" >&2
  exit 1
fi

PATH="$PROVIDER_PATH" "$CLI" start \
  --data-root "$DATA_ROOT" --port 0 --json >"$START_RESULT"
"$INSTALL_ROOT/bin/python" - "$START_RESULT" "$BOOTSTRAP_BODY" <<'PY'
import json
import pathlib
import sys

started = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert started["status"] == "started"
assert started["base_url"].startswith("http://127.0.0.1:")
assert started["bootstrap_token"] not in started["base_url"]
assert started["bootstrap_token"] not in started["web_url"]
pathlib.Path(sys.argv[2]).write_text(
    json.dumps({"token": started["bootstrap_token"]}, separators=(",", ":")),
    encoding="utf-8",
)
PY

BASE_URL=$("$INSTALL_ROOT/bin/python" -c '
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["base_url"])
' "$START_RESULT")

UNAUTHENTICATED_STATUS=$(curl --noproxy '*' --silent --output /dev/null \
  --write-out '%{http_code}' "$BASE_URL/api/v1/snapshot")
test "$UNAUTHENTICATED_STATUS" = "401"

curl --noproxy '*' --silent --show-error \
  --cookie-jar "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header 'Content-Type: application/json' \
  --data-binary "@$BOOTSTRAP_BODY" \
  "$BASE_URL/auth/bootstrap" >"$AUTH_RESULT"

CSRF_TOKEN=$("$INSTALL_ROOT/bin/python" -c '
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["csrf_token"])
' "$AUTH_RESULT")

curl --noproxy '*' --silent --show-error \
  --cookie "$COOKIE_JAR" \
  "$BASE_URL/api/v1/snapshot" >"$SNAPSHOT"
curl --noproxy '*' --silent --show-error \
  --cookie "$COOKIE_JAR" \
  "$BASE_URL/" >"$SHELL_HTML"

"$INSTALL_ROOT/bin/python" - "$SNAPSHOT" "$SHELL_HTML" "$SHELL_ASSETS" <<'PY'
from html.parser import HTMLParser
import json
import pathlib
import sys


class ShellAssetParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.assets: list[tuple[str, str]] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        values = dict(attrs)
        if tag == "script" and values.get("src"):
            self.assets.append(("script", str(values["src"])))
        if tag == "link" and values.get("rel") == "stylesheet" and values.get("href"):
            self.assets.append(("stylesheet", str(values["href"])))

snapshot = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert snapshot["product"] == {"name": "meta-research-vnext", "version": "0.1.0"}
assert snapshot["readiness"]["status"] == "ready"
assert snapshot["research_space"] == {
    "status": "empty",
    "quest_count": 0,
    "question_count": 0,
    "foreground_cycle_count": 0,
    "current_quest": {
        "status": "not_bound",
        "quest_ref": None,
        "goal_revision_ref": None,
        "draft_revision": None,
        "draft_hash": None,
        "goal": None,
        "completion_criteria": None,
        "projection_digest": None,
        "reason": {"code": "current_quest_not_bound"},
    },
}
assert set(snapshot["owners"]) == {
    "research_graph",
    "advancement_engine",
    "research_memory",
    "agent_runtime",
    "human_collaboration",
}
assert all(owner["status"] == "ready" for owner in snapshot["owners"].values())

shell = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8")
assert "Meta-research" in shell
assert "localStorage" not in shell
parser = ShellAssetParser()
parser.feed(shell)
assert any(kind == "script" for kind, _path in parser.assets)
assert any(kind == "stylesheet" for kind, _path in parser.assets)
for _kind, path in parser.assets:
    assert path.startswith("/assets/") and ".." not in path
pathlib.Path(sys.argv[3]).write_text(
    "".join(f"{kind}\t{path}\n" for kind, path in parser.assets),
    encoding="utf-8",
)
PY

mkdir -p "$SHELL_ASSET_ROOT"
ASSET_INDEX=0
while IFS=$'\t' read -r ASSET_KIND ASSET_PATH; do
  ASSET_INDEX=$((ASSET_INDEX + 1))
  ASSET_BODY="$SHELL_ASSET_ROOT/$ASSET_INDEX"
  ASSET_MIME=$(curl --noproxy '*' --silent --show-error --fail \
    --cookie "$COOKIE_JAR" \
    --output "$ASSET_BODY" \
    --write-out '%{content_type}' \
    "$BASE_URL$ASSET_PATH")
  test -s "$ASSET_BODY"
  if [[ "$ASSET_KIND" = "script" ]]; then
    [[ "$ASSET_MIME" = "text/javascript"* || "$ASSET_MIME" = "application/javascript"* ]]
  else
    [[ "$ASSET_MIME" = "text/css"* ]]
  fi
done <"$SHELL_ASSETS"

set +e
curl --noproxy '*' --silent --no-buffer --max-time 2 \
  --cookie "$COOKIE_JAR" \
  --header 'Last-Event-ID: 0' \
  "$BASE_URL/api/v1/events" >"$SSE_RESUME"
SSE_STATUS=$?
set -e
test "$SSE_STATUS" = "0" || test "$SSE_STATUS" = "28"
grep -F 'event: system.ready' "$SSE_RESUME" >/dev/null

set +e
curl --noproxy '*' --silent --show-error --no-buffer --max-time 2 \
  --cookie "$COOKIE_JAR" \
  --header 'Last-Event-ID: 999999' \
  "$BASE_URL/api/v1/events" >"$SSE_GAP"
SSE_GAP_STATUS=$?
set -e
test "$SSE_GAP_STATUS" = "0" || test "$SSE_GAP_STATUS" = "28"
grep -F 'event: snapshot.required' "$SSE_GAP" >/dev/null
grep -F '"snapshot_url":"/api/v1/snapshot"' "$SSE_GAP" >/dev/null

curl --noproxy '*' --silent --show-error --fail \
  --cookie "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header "X-CSRF-Token: $CSRF_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Idempotency-Key: installed-open-v2' \
  --data-binary '{}' \
  "$BASE_URL/api/v1/quest-initializations" >"$QUEST_OPENED"

INITIALIZATION_ID=$("$INSTALL_ROOT/bin/python" -c '
import json, sys
opened = json.load(open(sys.argv[1], encoding="utf-8"))
assert opened["status"] == "draft"
assert opened["quest_draft"]["schema_ref"].endswith("/v2")
assert opened["intent_session"]["status"] == "open"
print(opened["initialization_id"])
' "$QUEST_OPENED")

curl --noproxy '*' --silent --show-error --fail \
  --cookie "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header "X-CSRF-Token: $CSRF_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Idempotency-Key: installed-compute-probe' \
  --data-binary '{"selected_device_uuids":["GPU-installed-test"]}' \
  "$BASE_URL/api/v1/quest-initializations/$INITIALIZATION_ID/compute-probe" \
  >"$QUEST_PROBED"

"$INSTALL_ROOT/bin/python" - "$QUEST_PROBED" "$DRAFT_REQUEST" <<'PY'
import json
import pathlib
import sys

probed = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert probed["compute"]["status"] == "ready"
assert probed["resource_envelope"]["selected_device_uuids"] == ["GPU-installed-test"]
draft = dict(probed["quest_draft"]["value"])
draft.update(
    {
        "goal": "Verify the installed v2 Quest initialization boundary.",
        "completion_criteria": "Observe a typed provider failure without domain facts.",
        "time_budget": "30d",
        "background_and_initial_direction": "Exercise the public asynchronous API.",
    }
)
payload = {
    "expected_draft_revision": probed["quest_draft"]["revision"],
    "expected_draft_hash": probed["quest_draft"]["hash"],
    "draft": draft,
}
pathlib.Path(sys.argv[2]).write_text(
    json.dumps(payload, separators=(",", ":")), encoding="utf-8"
)
PY

curl --noproxy '*' --silent --show-error --fail \
  --request PUT \
  --cookie "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header "X-CSRF-Token: $CSRF_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Idempotency-Key: installed-autosave-v2' \
  --data-binary "@$DRAFT_REQUEST" \
  "$BASE_URL/api/v1/quest-initializations/$INITIALIZATION_ID/draft" \
  >"$QUEST_SAVED"

"$INSTALL_ROOT/bin/python" - \
  "$QUEST_PROBED" "$QUEST_SAVED" "$INTENT_REQUEST" "$GENERATION_REQUEST" <<'PY'
import json
import pathlib
import sys

probed = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
saved = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
assert saved["resource_envelope"]["ref"] != probed["resource_envelope"]["ref"]
assert saved["resource_envelope"]["status"] == "current"
assert saved["resource_envelope"]["time_budget"] == "30d"
assert saved["resource_envelope"]["hard_ceiling"] == {
    "kind": "wall_clock",
    "seconds": 2_592_000,
}
assert saved["quest_draft"]["value"]["resource_envelope_ref"] == saved[
    "resource_envelope"
]["ref"]
assert saved["quest_draft"]["value"]["resource_envelope_hash"] == saved[
    "resource_envelope"
]["hash"]
basis = {
    "expected_draft_revision": saved["quest_draft"]["revision"],
    "expected_draft_hash": saved["quest_draft"]["hash"],
}
pathlib.Path(sys.argv[3]).write_text(
    json.dumps({**basis, "message": "How should the boundary be narrowed?"}, separators=(",", ":")),
    encoding="utf-8",
)
pathlib.Path(sys.argv[4]).write_text(
    json.dumps(basis, separators=(",", ":")), encoding="utf-8"
)
PY

curl --noproxy '*' --silent --show-error --fail \
  --cookie "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header "X-CSRF-Token: $CSRF_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Idempotency-Key: installed-intent-turn' \
  --data-binary "@$INTENT_REQUEST" \
  "$BASE_URL/api/v1/quest-initializations/$INITIALIZATION_ID/intent-session/messages" \
  >/dev/null

curl --noproxy '*' --silent --show-error --fail \
  --cookie "$COOKIE_JAR" \
  --header "Origin: $BASE_URL" \
  --header "X-CSRF-Token: $CSRF_TOKEN" \
  --header 'Content-Type: application/json' \
  --header 'Idempotency-Key: installed-generate-proposal' \
  --data-binary "@$GENERATION_REQUEST" \
  "$BASE_URL/api/v1/quest-initializations/$INITIALIZATION_ID/proposal-generations" \
  >/dev/null

for _ in $(seq 1 100); do
  curl --noproxy '*' --silent --show-error --fail \
    --cookie "$COOKIE_JAR" \
    "$BASE_URL/api/v1/quest-initializations/$INITIALIZATION_ID" >"$QUEST_VIEW"
  if "$INSTALL_ROOT/bin/python" - "$QUEST_VIEW" <<'PY'
import json
import pathlib
import sys

view = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
generation = view.get("proposal_generation")
turns = view.get("intent_session", {}).get("turns", [])
raise SystemExit(
    0
    if generation
    and generation["status"] == "capability_unavailable"
    and turns
    and turns[0]["assistant_status"] == "unavailable"
    else 1
)
PY
  then
    break
  fi
  sleep 0.05
done

curl --noproxy '*' --silent --show-error --fail \
  --cookie "$COOKIE_JAR" \
  "$BASE_URL/api/v1/snapshot" >"$SNAPSHOT"

"$INSTALL_ROOT/bin/python" - "$QUEST_VIEW" "$SNAPSHOT" <<'PY'
import json
import pathlib
import sys

view = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
snapshot = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
assert view["proposal_generation"]["status"] == "capability_unavailable"
assert view["proposal_generation"]["failure"] == {"code": "codex_cli_unavailable"}
turn = view["intent_session"]["turns"][0]
assert turn["assistant_status"] == "unavailable"
assert turn["reason"] == {"code": "codex_cli_unavailable"}
assert view["proposal"] is None
assert view["confirmation_preview"] is None
assert all(receipt["status"] == "not_attempted" for receipt in view["receipts"].values())
assert snapshot["research_space"] == {
    "status": "empty",
    "quest_count": 0,
    "question_count": 0,
    "foreground_cycle_count": 0,
    "current_quest": {
        "status": "not_bound",
        "quest_ref": None,
        "goal_revision_ref": None,
        "draft_revision": None,
        "draft_hash": None,
        "goal": None,
        "completion_criteria": None,
        "projection_digest": None,
        "reason": {"code": "current_quest_not_bound"},
    },
}
PY

"$CLI" stop --data-root "$DATA_ROOT" --json | "$INSTALL_ROOT/bin/python" -c '
import json, sys
assert json.load(sys.stdin)["status"] == "stopped"
'
mkdir -p "$(dirname "$CODEX_EXECUTABLE")"
"$INSTALL_ROOT/bin/python" - \
  "$CODEX_EXECUTABLE" "$CODEX_CALLS" \
  "$DATA_ROOT/provider-homes/codex" <<'PY'
import pathlib
import sys


path = pathlib.Path(sys.argv[1])
calls_path = pathlib.Path(sys.argv[2])
expected_codex_home = pathlib.Path(sys.argv[3])
source = f'''#!{sys.executable}
import json
import os
import pathlib
import re
import sys


expected_codex_home = {str(expected_codex_home)!r}
assert os.environ.get("CODEX_HOME") == expected_codex_home
assert os.environ.get("CODEX_SQLITE_HOME") == expected_codex_home
args = sys.argv[1:]
if args == ["--version"]:
    print("codex-cli installed-fake 1")
    raise SystemExit(0)
assert args[0] == "exec"
assert "--skip-git-repo-check" in args
assert args[args.index("--cd") + 1]
assert "--json" in args
assert args[-1] == "-"
schema = json.loads(
    pathlib.Path(args[args.index("--output-schema") + 1]).read_text(
        encoding="utf-8"
    )
)
output_path = pathlib.Path(args[args.index("--output-last-message") + 1])
prompt = sys.stdin.read()
properties = set(schema["properties"])
resume_ref = None
if "resume" in args:
    resume_index = args.index("resume")
    resume_ref = args[resume_index + 1]

if properties == {{"reply"}}:
    assert args[args.index("--sandbox") + 1] == "read-only"
    match = re.search(r"(?m)^initialization_id=([^\\n]+)$", prompt)
    assert match is not None
    initialization_id = match.group(1)
    assert "Intent Drafting Session" in prompt
    assert "--ephemeral" not in args
    thread_id = f"installed-native-{{initialization_id}}"
    if resume_ref is not None:
        assert resume_ref == thread_id
    output = {{
        "reply": "建议把完成标准绑定到公开 Snapshot 与五层 Owner receipts。"
    }}
    print(json.dumps({{"type": "thread.started", "thread_id": thread_id}}))
    record = {{
        "kind": "intent",
        "ephemeral": False,
        "initialization_id": initialization_id,
        "resume_ref": resume_ref,
    }}
elif properties == {{
    "title",
    "unknown_statement",
    "answer_shape",
    "applicability_scope",
    "background_context",
    "requirements_constraints",
}}:
    assert args[args.index("--sandbox") + 1] == "read-only"
    match = re.search(r"(?m)^initialization_id=([^\\n]+)$", prompt)
    assert match is not None
    initialization_id = match.group(1)
    assert properties == {{
        "title",
        "unknown_statement",
        "answer_shape",
        "applicability_scope",
        "background_context",
        "requirements_constraints",
    }}
    assert args[-2:] == ["--ephemeral", "-"]
    assert "Proposal Drafter" in prompt
    output = {{
        "title": "安装态 production Adapter 与 Owner receipts",
        "unknown_statement": "尚未证明安装 wheel 能经真实 Codex CLI seam 形成可确认 Proposal。",
        "answer_shape": "形成带公开状态、五层 receipts 与重启恢复证据的有界结论。",
        "applicability_scope": "本地安装的 direct Quest 初始化路径。",
        "background_context": "验证 wheel、daemon、Codex adapter 与公开 HTTP 边界。",
        "requirements_constraints": "使用已选择 GPU envelope，并遵守 30 天硬上限。",
    }}
    record = {{
        "kind": "proposal",
        "ephemeral": True,
        "initialization_id": initialization_id,
        "resume_ref": resume_ref,
    }}
elif properties == {{"outcome"}}:
    assert "--ignore-user-config" in args
    assert args[args.index("--config") + 1] == "mcp_servers={{}}"
    config_values = {{
        args[index + 1]
        for index, value in enumerate(args[:-1])
        if value == "--config"
    }}
    assert 'approval_policy="never"' in config_values
    assert 'web_search="live"' in config_values
    assert args[args.index("--sandbox") + 1] == "danger-full-access"
    assert args[args.index("--model") + 1] == "gpt-5.4"
    enabled = {{
        args[index + 1]
        for index, value in enumerate(args[:-1])
        if value == "--enable"
    }}
    assert "multi_agent" in enabled
    disabled = {{
        args[index + 1]
        for index, value in enumerate(args[:-1])
        if value == "--disable"
    }}
    assert {{"apps", "browser_use", "computer_use"}} <= disabled
    assert "shell_tool" not in disabled
    assert "skill_search" not in disabled
    assert "view_image" not in disabled
    stage_match = re.search(r"(?m)^stage_request_ref=([^\\n]+)$", prompt)
    question_match = re.search(r"(?m)^question_ref=([^\\n]+)$", prompt)
    context_match = re.search(r"(?m)^context_pack_ref=([^\\n]+)$", prompt)
    assert stage_match is not None
    assert question_match is not None
    assert context_match is not None
    stage_request_ref = stage_match.group(1)
    question_ref = question_match.group(1)
    context_pack_ref = context_match.group(1)
    assert "Idea 主 Agent" in prompt
    assert "--ephemeral" not in args
    thread_id = f"installed-idea-native-{{stage_request_ref}}"
    if resume_ref is not None:
        assert resume_ref == thread_id
    output = {{
        "outcome": {{
            "kind": "IdeaSet",
            "question_ref": question_ref,
            "context_pack_ref": context_pack_ref,
            "candidates": [
                {{
                    "candidate_key": "installed-owner-chain",
                    "direction": "用公开 Projection 与逐层 receipt 验证安装态闭环。",
                    "rationale": "公开状态可同时证明执行、内容接纳、领域接纳和推进没有混同。",
                    "assumptions": ["loopback daemon 能持续恢复同一 SQLite 状态。"],
                    "risks": ["仅看最终状态可能遗漏中间时序错误。"],
                    "evidence_boundary": {{
                        "accepted_evidence_refs": [],
                        "supported": "Accepted Question 已冻结安装态验证范围。",
                        "inferred": "五层公开事实可揭示提前推进。",
                        "unknown": "不同宿主的恢复延迟仍可能变化。",
                    }},
                    "falsification_hint": {{
                        "test": "重启 daemon 并比较所有 receipt ref。",
                        "would_refute": "重启后 receipt 改变或 StageCommit 提前出现。",
                    }},
                    "material_difference": {{
                        "from_history": "当前 ContextPack 尚无已接纳 IdeaOutcome。",
                        "from_peers": "该候选以公开 Owner 事实而非进程内成功标志验收。",
                        "plan_commitment_change": "后续 Plan 必须保留安装与恢复证据。",
                    }},
                }}
            ],
            "recommendation": None,
        }}
    }}
    print(json.dumps({{"type": "thread.started", "thread_id": thread_id}}))
    record = {{
        "kind": "idea",
        "ephemeral": False,
        "stage_request_ref": stage_request_ref,
        "question_ref": question_ref,
        "resume_ref": resume_ref,
        "thread_id": thread_id,
    }}
elif properties == {{
    "reviewer_agent_ref",
    "findings",
    "final_outcome",
    "dispositions",
