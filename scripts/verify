    draft_match = re.search(r"(?m)^reviewed_draft=(.+)$", prompt)
    assert stage_match is not None
    assert question_match is not None
    assert context_match is not None
    assert draft_match is not None
    stage_request_ref = stage_match.group(1)
    question_ref = question_match.group(1)
    context_pack_ref = context_match.group(1)
    reviewed_draft = json.loads(draft_match.group(1))
