#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$PROJECT_ROOT"

uv lock --check
uv sync --locked --python 3.12
uv run --frozen pytest -p no:cacheprovider

(
  cd web
  npm ci
  env \
    -u FIXED_REFERENCE_CALIBRATE \
    -u FIXED_REFERENCE_CAPTURE_PENDING \
    META_RESEARCH_CHROME="${META_RESEARCH_CHROME:-/usr/bin/google-chrome}" \
    npm run test:e2e
)

if ! git diff --quiet -- src/meta_research/web_dist; then
  echo "web build changed tracked product assets; review and commit the rebuilt web_dist" >&2
  git diff --stat -- src/meta_research/web_dist >&2
  exit 1
fi

"$PROJECT_ROOT/scripts/verify"

if ! git diff --quiet -- src/meta_research/web_dist; then
  echo "installed verification changed tracked product assets" >&2
  git diff --stat -- src/meta_research/web_dist >&2
  exit 1
fi
