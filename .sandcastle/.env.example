# Non-secret controller settings. Sandcastle uses the current host `codex`
# login, configuration, and skills directly; never put credentials here.
SANDCASTLE_CODEX_MODEL=gpt-5.4
SANDCASTLE_BASE_REF=develop_main
SANDCASTLE_POLL_SECONDS=60
SANDCASTLE_MAX_AGENTS=3
SANDCASTLE_AGENT_WALL_CLOCK_SECONDS=28800
