# Restricted, revocable automation key used by Codex inside the sandbox.
# Stock Sandcastle 0.12.0 exposes it to the whole container lifetime, so use
# this environment only with trusted repository code.
CODEX_API_KEY=
SANDCASTLE_CODEX_MODEL=gpt-5.4
SANDCASTLE_BASE_REF=develop_main
SANDCASTLE_POLL_SECONDS=60
SANDCASTLE_AGENT_WALL_CLOCK_SECONDS=28800
