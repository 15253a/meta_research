{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-research.local/schemas/deployment_attestation.schema.json",
  "title": "Trusted deployment capability attestation",
  "description": "Short-lived operator evidence for a dedicated production deployment. Runtime still cross-checks every claim against one fresh observation.",
  "type": "object",
  "required": ["version", "protocol", "issued_at_unix", "service", "isolation", "docker", "work_root", "gpu"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "protocol": { "const": "deployment-attestation-v1" },
    "issued_at_unix": { "type": "number", "exclusiveMinimum": 0, "maximum": 253402300799 },
    "service": {
      "type": "object",
      "required": ["uid", "gid", "groups", "username", "codex_home"],
      "additionalProperties": false,
      "properties": {
        "uid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "groups": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 2147483647 } },
        "username": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "codex_home": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" }
      }
    },
    "isolation": {
      "type": "object",
      "required": ["kind", "deployment_id", "machine_id", "boot_id", "hostname", "vm_kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "dedicated-vm" },
        "deployment_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "machine_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "boot_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
        "vm_kind": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_.-]+$" }
      }
    },
    "docker": {
      "type": "object",
      "required": ["socket_path", "socket_uid", "socket_gid", "socket_mode", "daemon_id", "daemon_name", "rootless", "security_options", "cgroup_version", "cgroup_driver", "resource_mode", "root_dir", "runtimes", "min_free_bytes", "min_free_inodes"],
      "additionalProperties": false,
      "properties": {
        "socket_path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" },
        "socket_uid": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "socket_gid": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "socket_mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "daemon_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "daemon_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rootless": { "const": true },
        "security_options": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "cgroup_version": { "enum": ["1", "2"] },
        "cgroup_driver": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resource_mode": { "enum": ["cgroup-v1", "cgroup-v2"] },
        "root_dir": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" },
        "runtimes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "min_free_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "min_free_inodes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "work_root": {
      "type": "object",
      "required": ["path", "mount_point", "mount_source", "mount_fstype", "quota_provider", "quota_scope", "hard_bytes", "used_bytes", "hard_inodes", "used_inodes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" },
        "mount_point": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$" },
        "mount_source": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mount_fstype": { "const": "gpfs" },
        "quota_provider": { "const": "gpfs-fileset-v1" },
        "quota_scope": { "type": "string", "minLength": 9, "maxLength": 264, "pattern": "^fileset:[^\\u0000-\\u001f\\u007f]+$" },
        "hard_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "used_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "hard_inodes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "used_inodes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "gpu": {
      "type": "object",
      "required": ["memory_bytes_by_uuid"],
      "additionalProperties": false,
      "properties": {
        "memory_bytes_by_uuid": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^GPU-[A-Za-z0-9-]{1,128}$" },
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
