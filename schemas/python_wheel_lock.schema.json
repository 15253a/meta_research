{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-research.local/schemas/python_wheel_lock.schema.json",
  "title": "Canonical Python wheel lock v1",
  "type": "object",
  "required": ["version", "python", "platform", "distributions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "python": {
      "type": "object",
      "required": ["implementation", "version", "artifact_sha256"],
      "additionalProperties": false,
      "properties": {
        "implementation": { "const": "CPython" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifact_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "platform": {
      "const": { "os": "linux", "architecture": "amd64" }
    },
    "distributions": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["name", "version", "filename", "url", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,127}$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.whl$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 }
        }
      }
    }
  }
}
