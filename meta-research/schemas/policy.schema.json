{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-research.local/schemas/policy.schema.json",
  "title": "policy",
  "description": "policies/policy.yaml 的机械校验 schema（启动前提 §7.5 #4）。旋钮注册表唯一权威 = 第一部分附录 C（全量、每旋钮带默认值）；本 schema 与之逐节对齐、封闭（additionalProperties=false）。observation 节（parser 阈值）已随 M4 CP5.3 真 parser 落地（OPEN #5 已闭；extraction_policy_hash = 该节规范化 JSON 的 sha256，见 obs_parser）。",
  "type": "object",
  "required": ["acquisition", "budget", "flow", "retrieval", "import_search", "import_materialization", "import_reference", "session", "tree_guard", "question_guard", "answer_review", "goal_amend", "cards", "idea", "interaction", "execution", "resources", "deployment", "interaction_request", "observation"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["execution"],
        "properties": {
          "execution": {
            "required": ["sandbox"],
            "properties": {
              "sandbox": {
                "required": ["local_environment"],
                "properties": { "local_environment": { "type": "object" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "required": ["mode"],
            "properties": { "mode": { "const": "development" } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["execution"],
        "properties": {
          "execution": {
            "required": ["sandbox"],
            "properties": {
              "sandbox": {
                "required": ["network_mode"],
                "properties": { "network_mode": { "const": "bridge" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "required": ["mode"],
            "properties": { "mode": { "const": "development" } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["execution"],
        "properties": {
          "execution": {
            "required": ["sandbox"],
            "properties": {
              "sandbox": {
                "required": ["development_gpu_thread_limit"],
                "properties": { "development_gpu_thread_limit": { "type": "integer" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "required": ["mode"],
            "properties": { "mode": { "const": "development" } }
          },
          "execution": {
            "properties": {
              "sandbox": {
                "properties": { "local_environment": { "type": "object" } }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "acquisition": {
      "type": "object",
      "required": ["w1", "w2", "w3", "c"],
      "additionalProperties": false,
      "properties": {
        "w1": { "type": "number", "minimum": 0, "description": "期望增益权重" },
        "w2": { "type": "number", "minimum": 0, "description": "信息量权重" },
        "w3": { "type": "number", "minimum": 0, "description": "成本惩罚权重" },
        "c": { "type": "number", "minimum": 0, "description": "UCB 探索系数" }
      }
    },
    "budget": {
      "type": "object",
      "required": ["B0", "doubling_period_m", "B_max", "session_max"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["session_max"],
            "properties": { "session_max": { "type": "number" } }
          },
          "then": {
            "required": ["price_per_1k_tokens"],
            "properties": { "price_per_1k_tokens": { "exclusiveMinimum": 0 } }
          }
        }
      ],
      "properties": {
        "B0": { "type": "number", "exclusiveMinimum": 0 },
        "doubling_period_m": { "type": "integer", "minimum": 1 },
        "B_max": { "type": "number", "exclusiveMinimum": 0 },
        "session_max": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "price_per_1k_tokens": { "type": "number", "minimum": 0, "description": "步⑩ M6：tokens→money 汇率（ledger.money=tokens/1000×本值，notional/USD-等效）。session_max 为数字时本项必填且须>0；仅 session_max=null 关闭预算网时允许缺键/0" }
      }
    },
    "flow": {
      "type": "object",
      "required": ["decompose_threshold", "tau", "audit_cadence_K", "retry", "watchdog"],
      "additionalProperties": false,
      "properties": {
        "decompose_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "tau": {
          "type": "object",
          "required": ["score_floor", "consecutive_rounds"],
          "additionalProperties": false,
          "properties": {
            "score_floor": { "type": "number" },
            "consecutive_rounds": { "type": "integer", "minimum": 1 }
          }
        },
        "audit_cadence_K": { "type": "integer", "minimum": 1 },
        "retry": {
          "type": "object",
          "required": ["artifact_parse", "bundle_repair", "plan_review", "bundle_code_review", "bundle_result_review"],
          "additionalProperties": false,
          "properties": {
            "artifact_parse": { "type": "integer", "minimum": 0 },
            "bundle_repair": { "type": ["integer", "null"], "minimum": 0, "maximum": 3, "description": "同一 build_target 在冻结 plan 内可请求的实施自愈次数；null 表示工程修复不限轮次，直到成功或 Bundle Codex 明确判定为 plan 缺陷并回 Reasoning" },
            "plan_review": { "type": "integer", "minimum": 0, "maximum": 1 },
            "bundle_code_review": { "type": "integer", "minimum": 0, "maximum": 1 },
            "bundle_result_review": { "type": "integer", "minimum": 0, "maximum": 1 }
          }
        },
        "watchdog": {
          "type": "object",
          "description": "单次执行时限唯一定义点（资源硬件事实在 resources 节，不在此）",
          "required": ["probe_h", "full_h"],
          "additionalProperties": false,
          "properties": {
            "probe_h": { "type": "number", "exclusiveMinimum": 0 },
            "full_h": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["recipe", "budget_by_question_scale", "scale_thresholds", "gate2_stuck_threshold"],
      "additionalProperties": false,
      "properties": {
        "recipe": { "type": "string", "minLength": 1 },
        "budget_by_question_scale": {
          "type": "object",
          "required": ["small", "medium", "large"],
          "additionalProperties": false,
          "properties": {
            "small": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "large": { "type": "integer", "minimum": 0 }
          }
        },
        "scale_thresholds": {
          "type": "object",
          "description": "import_search 闸3 的机械分档线；est_cost_ratio=question.est_cost/B(t)，或 score 任一达线即进档",
          "required": ["medium", "large"],
          "additionalProperties": false,
          "properties": {
            "medium": {
              "type": "object", "required": ["est_cost_ratio", "score"], "additionalProperties": false,
              "properties": {
                "est_cost_ratio": { "type": "number", "minimum": 0 },
                "score": { "type": "number" }
              }
            },
            "large": {
              "type": "object", "required": ["est_cost_ratio", "score"], "additionalProperties": false,
              "properties": {
                "est_cost_ratio": { "type": "number", "minimum": 0 },
                "score": { "type": "number" }
              }
            }
          }
        },
        "gate2_stuck_threshold": {
          "type": "object",
          "required": ["visit_count", "consecutive_inconclusive"],
          "additionalProperties": false,
          "properties": {
            "visit_count": {
              "type": "integer", "minimum": 1,
              "description": "Lifetime anti-greedy visit threshold."
            },
            "consecutive_inconclusive": {
              "type": "integer", "minimum": 1,
              "description": "Current-goal-version append-only inconclusive streak threshold."
            }
          }
        }
      }
    },
    "import_search": {
      "type": "object",
      "description": "受信 host 只读 repo-search 与机械 license 策略；凭据从命名环境变量读取，不进 policy",
      "required": ["provider", "max_candidates", "timeout_s", "max_response_bytes", "auto_license"],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "github_rest_v1" },
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeout_s": { "type": "number", "minimum": 1, "maximum": 60 },
        "max_response_bytes": { "type": "integer", "minimum": 65536, "maximum": 4194304 },
        "auto_license": {
          "type": "object",
          "required": ["allow_spdx", "scope"],
          "additionalProperties": false,
          "properties": {
            "allow_spdx": {
              "type": "array", "maxItems": 32, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$" }
            },
            "scope": {
              "type": "object",
              "required": ["allow_eval", "allow_modify", "allow_publish_pool", "allow_redistribute"],
              "additionalProperties": false,
              "properties": {
                "allow_eval": { "type": "boolean" },
                "allow_modify": { "type": "boolean" },
                "allow_publish_pool": { "type": "boolean" },
                "allow_redistribute": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "import_materialization": {
      "type": "object",
      "description": "pinned GitHub commit 的可信 host 物化：Git tree/archive、Git LFS OID/size 双核、wheel dependency image、内容寻址发布与 adapter v2/v3",
      "required": ["provider", "adapter_path", "timeout_s", "max_api_response_bytes", "max_archive_bytes", "max_file_bytes", "max_total_bytes", "max_files", "max_tree_depth", "max_tree_objects", "max_submodules", "lfs_policy", "max_lfs_objects", "lfs_batch_size", "allowed_archive_hosts", "allowed_lfs_hosts", "dependency_lock_names", "adapter_generation", "dependency_image", "compiler"],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "github_archive_v1" },
        "adapter_path": { "const": ".meta-research/import-adapter.json" },
        "timeout_s": { "type": "number", "minimum": 1, "maximum": 300 },
        "max_api_response_bytes": { "type": "integer", "minimum": 65536, "maximum": 16777216 },
        "max_archive_bytes": { "type": "integer", "minimum": 1048576, "maximum": 68719476736 },
        "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
        "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "max_files": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_tree_depth": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_tree_objects": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_submodules": { "type": "integer", "minimum": 0, "maximum": 256 },
        "lfs_policy": { "const": "fetch" },
        "max_lfs_objects": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "lfs_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "allowed_archive_hosts": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
        },
        "allowed_lfs_hosts": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
        },
        "dependency_lock_names": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" }
        },
        "adapter_generation": {
          "type": "object",
          "required": ["provider", "prompt_version", "max_inventory_paths", "max_inventory_bytes", "max_preview_files", "max_preview_file_bytes", "max_preview_total_bytes", "max_projection_bytes"],
          "additionalProperties": false,
          "properties": {
            "provider": { "const": "codex-reviewed-sidecar-v1" },
            "prompt_version": { "const": 1 },
            "max_inventory_paths": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "max_inventory_bytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
            "max_preview_files": { "type": "integer", "minimum": 1, "maximum": 256 },
            "max_preview_file_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "max_preview_total_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
            "max_projection_bytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 }
          }
        },
        "dependency_image": {
          "type": "object",
          "required": ["provider", "lock_basename", "allowed_hosts", "timeout_s", "max_lock_bytes", "max_wheels", "max_wheel_bytes", "max_total_wheel_bytes", "max_unpacked_wheel_bytes", "max_wheel_entries", "max_installed_bytes", "max_installed_files", "install_timeout_s", "build_timeout_s", "load_timeout_s", "max_image_archive_bytes", "max_cached_images", "site_packages_path"],
          "additionalProperties": false,
          "properties": {
            "provider": { "const": "python-wheel-image-v1" },
            "lock_basename": { "const": "python-wheel-lock.json" },
            "allowed_hosts": {
              "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
            },
            "timeout_s": { "type": "number", "minimum": 1, "maximum": 86400 },
            "max_lock_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
            "max_wheels": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "max_wheel_bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
            "max_total_wheel_bytes": { "type": "integer", "minimum": 1, "maximum": 68719476736 },
            "max_unpacked_wheel_bytes": { "type": "integer", "minimum": 1, "maximum": 137438953472 },
            "max_wheel_entries": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "max_installed_bytes": { "type": "integer", "minimum": 1, "maximum": 137438953472 },
            "max_installed_files": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "install_timeout_s": { "type": "number", "minimum": 1, "maximum": 86400 },
            "build_timeout_s": { "type": "number", "minimum": 1, "maximum": 86400 },
            "load_timeout_s": { "type": "number", "minimum": 1, "maximum": 86400 },
            "max_image_archive_bytes": { "type": "integer", "minimum": 1, "maximum": 274877906944 },
            "max_cached_images": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "site_packages_path": { "const": "/opt/meta-research/site-packages" }
          }
        },
        "compiler": {
          "type": "object",
          "required": ["implementation", "version", "artifact_sha256"],
          "additionalProperties": false,
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "artifact_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "import_reference": {
      "type": "object",
      "description": "human_named/stuck/sota_reference 的可信来源与独立参照问题护栏",
      "required": ["max_child_questions_per_survey", "reference_snapshot"],
      "additionalProperties": false,
      "properties": {
        "max_child_questions_per_survey": { "const": 1 },
        "reference_snapshot": {
          "type": "object",
          "required": ["provider", "allowed_hosts", "timeout_s", "max_response_bytes"],
          "additionalProperties": false,
          "properties": {
            "provider": { "const": "bounded_https_v1" },
            "allowed_hosts": {
              "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": {
                "type": "string", "minLength": 1, "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              }
            },
            "timeout_s": { "type": "number", "minimum": 1, "maximum": 60 },
            "max_response_bytes": { "type": "integer", "minimum": 65536, "maximum": 16777216 }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["dual_mode"],
      "additionalProperties": false,
      "properties": {
        "dual_mode": { "const": "A", "description": "生产只接受 A=一 turn 一阶段；未实现真正 turn 内跨阶段提交的 B 必须 fail-closed" }
      }
    },
    "tree_guard": {
      "type": "object",
      "required": ["max_decompose_depth", "max_children_per_node", "max_open_questions"],
      "additionalProperties": false,
      "properties": {
        "max_decompose_depth": { "type": "integer", "minimum": 1 },
        "max_children_per_node": { "type": "integer", "minimum": 1 },
        "max_open_questions": { "type": "integer", "minimum": 1 }
      }
    },
    "question_guard": {
      "type": "object",
      "required": ["max_inconclusive_per_question"],
      "additionalProperties": false,
      "properties": {
        "max_inconclusive_per_question": { "type": "integer", "minimum": 1 }
      }
    },
    "answer_review": {
      "type": "object",
      "required": ["max_reviews_per_cycle", "spawn_counts_toward_max_open"],
      "additionalProperties": false,
      "properties": {
        "max_reviews_per_cycle": { "type": "integer", "minimum": 1 },
        "spawn_counts_toward_max_open": { "type": "boolean" }
      }
    },
    "goal_amend": {
      "type": "object",
      "required": ["max_closed_revalidate_per_cycle", "max_spawn_from_goal_amend"],
      "additionalProperties": false,
      "properties": {
        "max_closed_revalidate_per_cycle": { "type": "integer", "minimum": 1 },
        "max_spawn_from_goal_amend": { "type": "integer", "minimum": 1 }
      }
    },
    "cards": {
      "type": "object",
      "required": ["subtree_card_depth", "tag_policy"],
      "additionalProperties": false,
      "properties": {
        "subtree_card_depth": { "type": "integer", "minimum": 1 },
        "tag_policy": { "type": "string", "minLength": 1 }
      }
    },
    "idea": {
      "type": "object",
      "required": ["engine", "problem_type", "slot_count", "candidate_top_k", "max_attempts", "thresholds", "novelty_check", "sd_threshold", "dedup_budget", "forbid_proto_term_source", "cross_phase"],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "object",
          "required": ["name", "version", "adapter_version", "profile"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "wildidea" },
            "version": { "const": "wildidea@6ff66ada15b0047b2e03d229f2e9543c542df598" },
            "adapter_version": { "const": "meta-research-wildidea-adapter-v1" },
            "profile": { "const": "research" }
          }
        },
        "problem_type": { "const": "research" },
        "slot_count": { "const": 9 },
        "sd_threshold": { "type": "number", "minimum": 0, "maximum": 10 },
        "candidate_top_k": { "const": 3 },
        "max_attempts": { "const": 3 },
        "thresholds": {
          "type": "object",
          "required": ["research"],
          "additionalProperties": false,
          "properties": {
            "research": {
              "type": "object",
              "required": ["structural_depth", "domain_distance", "applicability", "novelty"],
              "additionalProperties": false,
              "properties": {
                "structural_depth": { "const": 6 },
                "domain_distance": { "const": 7 },
                "applicability": { "const": 6 },
                "novelty": { "const": 8 }
              }
            }
          }
        },
        "novelty_check": {
          "type": "object",
          "required": ["enabled", "status"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "enum": ["pending_controlled_backend", "controlled_backend_enabled"] },
            "provider": { "const": "arxiv_api_v1" },
            "endpoint": { "const": "https://export.arxiv.org/api/query" },
            "queries_per_candidate": { "const": 1 },
            "max_results_per_query": { "type": "integer", "minimum": 1, "maximum": 50 },
            "timeout_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
            "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
            "min_interval_s": { "type": "number", "minimum": 0, "maximum": 60 },
            "retry_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
            "retry_initial_delay_s": { "type": "number", "minimum": 0, "maximum": 120 },
            "retry_max_delay_s": { "type": "number", "minimum": 0, "maximum": 600 }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
              "then": { "properties": { "status": { "const": "pending_controlled_backend" } } }
            },
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "required": [
                  "provider", "endpoint", "queries_per_candidate", "max_results_per_query",
                  "timeout_s", "max_response_bytes", "min_interval_s"
                ],
                "properties": { "status": { "const": "controlled_backend_enabled" } }
              }
            }
          ]
        },
        "dedup_budget": { "type": "integer", "minimum": 0 },
        "forbid_proto_term_source": { "type": "string", "minLength": 1 },
        "cross_phase": {
          "type": "object",
          "required": ["decompose_assist", "spawn_assist", "budget"],
          "additionalProperties": false,
          "properties": {
            "decompose_assist": { "type": "boolean" },
            "spawn_assist": { "type": "boolean" },
            "budget": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["classify_conservativeness", "ack_sla_s", "query_sla_s", "responder_fallback", "mediator_rebuild_last_n", "notify_matrix"],
      "additionalProperties": false,
      "properties": {
        "classify_conservativeness": { "enum": ["low", "medium", "high"] },
        "ack_sla_s": { "type": "number", "exclusiveMinimum": 0 },
        "query_sla_s": { "type": "number", "exclusiveMinimum": 0 },
        "responder_fallback": {
          "type": "object",
          "required": ["grounding_fail_to_template"],
          "additionalProperties": false,
          "properties": {
            "grounding_fail_to_template": { "type": "integer", "minimum": 1 }
          }
        },
        "mediator_rebuild_last_n": { "type": "integer", "minimum": 1, "maximum": 100 },
        "notify_matrix": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "description": "execution_manifest 命令围栏（步⑧ CP8.1；执法点 orchestrator/manifest.py）：manifest 命令超时与路径边界唯一定义点",
      "required": ["default_timeout_s", "max_timeout_s", "path_allowlist", "sandbox"],
      "additionalProperties": false,
      "properties": {
        "default_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "max_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "path_allowlist": { "type": "array", "items": { "type": "string", "pattern": "^/" }, "description": "允许 argv 引用的 work_root 以外绝对路径前缀（如真数据根）" },
        "sandbox": {
          "type": "object",
          "description": "bundle/import 敌对执行后端；exact image pin、policy-selected network（production=none，development 可显式 bridge）、只读 rootfs 与资源边界由 execution_sandbox.py 执法",
          "required": ["backend", "engine_path", "engine_host", "resource_mode", "network_mode", "seccomp_profile", "seccomp_sha256", "seccomp_bpf", "seccomp_bpf_sha256", "seccomp_bpf_arch", "image", "image_id", "python_path", "memory_mb", "pids", "nofile", "max_log_mb", "max_file_mb", "max_output_mb", "max_output_files", "cpus", "development_gpu_thread_limit", "tmpfs_mb", "shm_mb", "input_max_mb", "readonly_mounts", "payload_environment", "local_environment"],
          "additionalProperties": false,
          "properties": {
            "backend": { "const": "docker" },
            "engine_path": { "type": "string", "pattern": "^/" },
            "engine_host": { "type": "string", "pattern": "^unix:///" },
            "resource_mode": { "enum": ["cgroup-v1", "cgroup-v2", "rlimit-fallback"] },
            "network_mode": { "enum": ["none", "bridge"] },
            "seccomp_profile": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
            "seccomp_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "seccomp_bpf": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
            "seccomp_bpf_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "seccomp_bpf_arch": { "const": "amd64" },
            "image": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$" },
            "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "python_path": { "type": "string", "pattern": "^/" },
            "memory_mb": { "type": "integer", "minimum": 64 },
            "pids": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "nofile": { "type": "integer", "minimum": 16, "maximum": 1048576 },
            "max_log_mb": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "max_file_mb": { "type": "integer", "minimum": 1 },
            "max_output_mb": { "type": "integer", "minimum": 1 },
            "max_output_files": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "cpus": { "type": "number", "exclusiveMinimum": 0 },
            "development_gpu_thread_limit": {
              "description": "仅 development local-environment GPU invocation 注入的 BLAS/OMP 线程上限；null 为禁用。安全硬边界仍由 pids/cgroup/RLIMIT 执法。",
              "type": ["integer", "null"], "minimum": 1, "maximum": 4096
            },
            "tmpfs_mb": { "type": "integer", "minimum": 1 },
            "shm_mb": { "type": "integer", "minimum": 1 },
            "input_max_mb": { "type": "integer", "minimum": 1 },
            "readonly_mounts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
            "payload_environment": {
              "type": "object", "maxProperties": 32,
              "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^=\\u0000]+$" },
              "additionalProperties": { "type": "string", "maxLength": 65536 }
            },
            "local_environment": {
              "description": "仅 development 可启用的本机 Conda prefix 只读 bind；null 表示禁用。不得并入 qualification readonly_mounts/path_allowlist。",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["enabled", "development_only", "source", "target", "python_path", "identity_sha256"],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "const": true },
                    "development_only": { "const": true },
                    "source": { "type": "string", "pattern": "^/[^,:\\u0000\\r\\n]*$", "maxLength": 4096 },
                    "target": { "const": "/opt/host-conda" },
                    "python_path": { "const": "/opt/host-conda/bin/python" },
                    "identity_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "启动输入③：硬件请求与显式 target GPU 计划合同（时限唯一归 flow.watchdog，§4.6.7）。gpus 不得暗推 target mode；gpu_target_policy 由编排器独立执法。",
      "required": ["gpus", "gpu_mem_gb", "disk_quota_gb", "gpu_target_policy", "allowed_device_indices"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "gpus": { "const": 0 } }, "required": ["gpus"] },
          "then": { "properties": { "gpu_mem_gb": { "const": 0 }, "allowed_device_indices": { "maxItems": 0 } } },
          "else": { "properties": { "gpu_mem_gb": { "exclusiveMinimum": 0 }, "allowed_device_indices": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "gpu_target_policy": { "const": "required" } }, "required": ["gpu_target_policy"] },
          "then": { "properties": { "gpus": { "minimum": 1 }, "gpu_mem_gb": { "exclusiveMinimum": 0 }, "allowed_device_indices": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "gpu_target_policy": { "const": "forbidden" } }, "required": ["gpu_target_policy"] },
          "then": { "properties": { "gpus": { "const": 0 }, "gpu_mem_gb": { "const": 0 }, "allowed_device_indices": { "maxItems": 0 } } }
        }
      ],
      "properties": {
        "gpus": { "type": "integer", "minimum": 0 },
        "gpu_mem_gb": { "type": "number", "minimum": 0 },
        "disk_quota_gb": { "type": "number", "minimum": 0 },
        "gpu_target_policy": {
          "enum": ["planner_select", "required", "forbidden"],
          "description": "planner_select=计划者逐 target 显式决定；required=所有新执行 target 及 evaluation 复用必须 gpu_required=true；forbidden=必须 false。"
        },
        "allowed_device_indices": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "description": "部署可从 live NVIDIA inventory 选取的 index 窄化集；须升序且数量不少于 gpus，运行时再机械执法。",
          "items": { "type": "integer", "minimum": 0, "maximum": 4095 }
        }
      }
    },
    "deployment": {
      "type": "object",
      "description": "启动部署信任合同。development 只发布 production_ready=false 的诚实回执；production 实时核 service/Docker/cgroup/GPU/mount，并只接受部署 root 在 300 秒内签发的 GPFS hard-quota snapshot。",
      "required": ["mode", "attestation_path", "max_attestation_age_s"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "development" } }, "required": ["mode"] },
          "then": { "properties": { "attestation_path": { "type": "null" } } },
          "else": { "properties": {
            "attestation_path": { "type": "string", "pattern": "^/[^\\u0000]*$", "maxLength": 4096 },
            "max_attestation_age_s": { "maximum": 300 }
          } }
        }
      ],
      "properties": {
        "mode": { "enum": ["development", "production"] },
        "attestation_path": { "type": ["string", "null"] },
        "max_attestation_age_s": { "type": "integer", "minimum": 60, "maximum": 604800 }
      }
    },
    "interaction_request": {
      "type": "object",
      "required": ["enabled", "max_items_per_request", "max_requests_per_goal", "remind_interval_h"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_items_per_request": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_requests_per_goal": { "type": "integer", "minimum": 1, "maximum": 5 },
        "remind_interval_h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "observation": {
      "type": "object",
      "required": ["parse", "suspect"],
      "additionalProperties": false,
      "properties": {
        "parse": {
          "type": "object",
          "required": ["divergence_ratio", "trend_window", "flat_epsilon"],
          "additionalProperties": false,
          "properties": {
            "divergence_ratio": { "type": "number", "exclusiveMinimum": 0 },
            "trend_window": { "type": "integer", "minimum": 2 },
            "flat_epsilon": { "type": "number", "minimum": 0 }
          }
        },
        "suspect": {
          "type": "object",
          "required": ["nan_seen", "divergence_flag", "loss_trend_suspect", "max_oom_count", "max_retry_count"],
          "additionalProperties": false,
          "properties": {
            "nan_seen": { "type": "boolean" },
            "divergence_flag": { "type": "boolean" },
            "loss_trend_suspect": { "type": "array", "items": { "enum": ["down", "flat", "up", "nan", "unknown"] } },
            "max_oom_count": { "type": "integer", "minimum": 0 },
            "max_retry_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
