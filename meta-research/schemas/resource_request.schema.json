{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-research.local/schemas/resource_request.schema.json",
  "title": "resource_request",
  "description": "统一可选 sidecar（四阶段皆适用，§3.1.1 / §4.6.8）：系统确实无法自行获取资料时，面向用户的最小请求。它只表达缺什么及用途；请求状态、托管落位和运行审计由编排器维护，不要求模型重复填写。",
  "type": "object",
  "required": ["summary_md", "items"],
  "additionalProperties": false,
  "properties": {
    "summary_md": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
      "description": "易懂语言（中文）：期望做什么 / 为何自己获取不到 / 需要用户提供什么"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["kind", "desc"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["dataset", "paper", "wet_lab", "other", "permission"],
            "description": "permission 只表示用户可二选一授权的既知能力；不得附上传文件。其余类型表示需要用户补充真实资料或信息。"
          },
          "desc": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
          "expected_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" }
          },
          "attempted_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "description": "可选诊断提示；仅在确有助于用户理解时填写，不是模型自证表",
            "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" }
          },
          "failure_reason": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]*$", "description": "可选的具体阻塞原因；summary_md 已说明时省略" },
          "dest_hint": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]*$", "description": "向后兼容的可选提示；真实托管位置始终由服务端决定" }
        }
      }
    }
  }
}
