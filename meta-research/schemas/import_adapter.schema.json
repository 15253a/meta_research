{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-research.local/schemas/import_adapter.schema.json",
  "title": "Pinned repository import adapter v2/v3",
  "type": "object",
  "required": ["version", "artifact_relpath", "artifact_type", "smoke_argv", "eval_argv", "dependency_mode", "dependency_locks", "factory_protocol"],
  "additionalProperties": false,
  "properties": {
    "version": { "enum": [2, 3] },
    "artifact_relpath": { "$ref": "#/$defs/relpath" },
    "artifact_type": { "enum": ["checkpoint", "external_model", "prompt_only", "algorithm", "retrieval_index"] },
    "smoke_argv": { "$ref": "#/$defs/argv" },
    "eval_argv": { "$ref": "#/$defs/argv" },
    "dependency_mode": { "enum": ["pinned_image_only", "python_wheel_image_v1"] },
    "dependency_locks": {
      "type": "array", "maxItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/relpath" }
    },
    "factory_protocol": {
      "type": "object",
      "required": ["name", "version", "scope_spec", "metrics", "required"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "scope_spec": { "type": "object", "minProperties": 1 },
        "metrics": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["log_key", "name", "version", "direction", "unit", "compute_spec", "readout_rule"],
            "additionalProperties": false,
            "properties": {
              "log_key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 512 },
              "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
              "direction": { "enum": ["higher", "lower"] },
              "unit": { "$ref": "#/$defs/nullable_text" },
              "compute_spec": { "$ref": "#/$defs/text" },
              "readout_rule": { "$ref": "#/$defs/text" }
            }
          }
        },
        "required": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 2 } }, "required": ["version"] },
      "then": {
        "properties": {
          "dependency_mode": { "const": "pinned_image_only" },
          "dependency_locks": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": 3 } }, "required": ["version"] },
      "then": {
        "properties": {
          "dependency_mode": { "const": "python_wheel_image_v1" },
          "dependency_locks": {
            "minItems": 1, "maxItems": 1,
            "items": { "type": "string", "pattern": "(^|/)python-wheel-lock\\.json$" }
          }
        }
      }
    }
  ],
  "$defs": {
    "relpath": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    },
    "argv": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "nullable_text": {
      "type": ["string", "null"], "minLength": 1, "maxLength": 8192
    },
    "text": {
      "type": "string", "minLength": 1, "maxLength": 8192
    }
  }
}
