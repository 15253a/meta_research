{
  "name": "@meta-research/web-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.tests.json",
    "build": "npm run typecheck && vite build",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
